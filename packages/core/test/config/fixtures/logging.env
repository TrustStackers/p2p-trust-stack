# A component .env as `logging-env` reads it: comments, blank lines and
# unrelated keys are all present, because a real component's .env carries the
# bootstrap block too.

# ── Bootstrap / relay ──
BOOTSTRAP_PEER_ID=12D3KooWKF2Tmh21NNSH5gWazfbmFEtTZS9XT1uXk8njFAy5jUda
BOOTSTRAP_HOST=relay.example.com

# ── Logging ──
P2PTS_LOG_LEVEL=debug
CEREMONY_TRACE=1
